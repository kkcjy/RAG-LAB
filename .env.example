# ============================================================
#  RAG-LAB 环境配置
#  复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---------- 应用 ----------
APP_NAME=RAG-LAB
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-32-char-string-please
# JWT 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=raglab
POSTGRES_PASSWORD=raglab_pass_change_me
POSTGRES_DB=raglab

# ---------- Qdrant 向量库 ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
# 向量维度：BGE-M3 = 1024
QDRANT_VECTOR_SIZE=1024

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
#  LLM Provider —— 双模式核心开关
#  provider 可选: deepseek | openai_compatible | vllm_local
# ============================================================
LLM_PROVIDER=deepseek

# --- 模式 A: DeepSeek 官方 API ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 模式 B: 任意 OpenAI 兼容接口（硅基流动/OpenAI/自建等）---
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# --- 模式 C: 本地 vLLM ---
# 启动 vLLM 后填这里，例如 http://host.docker.internal:8001/v1
VLLM_BASE_URL=
VLLM_MODEL=

# LLM 通用参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ---------- Embedding Provider —— 本地 BGE-M3 ----------
#  provider 可选: local_bge | openai_compatible
EMBEDDING_PROVIDER=local_bge

# HuggingFace 端点。国内网络必须用镜像，海外服务器可注释掉走官方源
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（对应 compose 挂载的 data/hf_cache）
HF_HOME=/app/data/hf_cache

# 模型选择（按需替换，注意维度变化需同步改 QDRANT_VECTOR_SIZE）
#   BAAI/bge-m3            约2.3GB  维度1024  多语言长文本，效果最好（默认）
#   BAAI/bge-large-zh-v1.5 约1.3GB  维度1024  纯中文，省内存
#   BAAI/bge-base-zh-v1.5  约400MB  维度768   轻量均衡
#   BAAI/bge-small-zh-v1.5 约100MB  维度512   极轻量
BGE_MODEL_PATH=BAAI/bge-m3
BGE_DEVICE=cpu
# CPU 推理线程数
BGE_NUM_THREADS=4
# 批量编码大小
BGE_BATCH_SIZE=16
# 归一化（余弦相似度建议 true）
BGE_NORMALIZE=true

# --- Embedding 走 API 时的配置（provider=openai_compatible 时生效）---
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_MODEL=

# ============================================================
#  检索策略（路线 C：混合式）
# ============================================================
# 相似度阈值：低于此值判定"本地无相关"  (余弦相似度 0~1)
RETRIEVAL_SCORE_THRESHOLD=0.50
# 向量检索返回条数
RETRIEVAL_TOP_K=5
# 是否启用 LLM 精判（把候选片段丢给 LLM 判断能否回答）
RETRIEVAL_LLM_JUDGE=true
# 是否启用 Query 改写
QUERY_REWRITE_ENABLED=true
# 是否在检索结果不足时自动联网
WEB_SEARCH_AUTO_FALLBACK=true

# ============================================================
#  联网搜索 —— Tavily
# ============================================================
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# ============================================================
#  文档处理
# ============================================================
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.md,.markdown,.txt
# 分块参数
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# 入库后是否立即向量化
AUTO_INDEX_ON_UPLOAD=true

# ============================================================
#  OCR（扫描件 PDF）
# ============================================================
# 文本提取为空时自动转 OCR 识别（本地 RapidOCR，无需联网）
OCR_ENABLED=true
# 单文档最多 OCR 页数，防止超长扫描件拖垮 CPU
OCR_MAX_PAGES=30
# 页面渲染分辨率，越高越准但越慢（200 通常够用）
OCR_DPI=200


# ============================================================
#  管理员初始账户（首次启动自动创建）
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@example.com
