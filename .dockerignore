# ===========================================================================
#  Docker 构建上下文排除清单
#
#  关键：.env 绝不能进镜像 —— 它含 API key / 数据库密码。
#  运行时由 docker-compose 的 env_file 注入，无需打进镜像。
# ===========================================================================

# ---------- 敏感配置 ----------
.env
.env.*
*.env
!.env.example

# ---------- 运行时数据（挂载卷提供）----------
data/
!data/.gitkeep

# ---------- 版本控制 ----------
.git
.gitignore

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ---------- 本地开发/临时文件 ----------
*.bak
*.log
*.tar.gz
.vscode/
.idea/
.DS_Store
